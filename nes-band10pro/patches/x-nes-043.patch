 impl Emulator {
+    /// Create an emulator in caller-provided storage, bypassing the large
+    /// by-value return of [`Emulator::new`] on small MCU stacks.
+    ///
+    /// # Safety
+    /// `ptr` must be valid, aligned and uninitialised for `Emulator`.
+    pub unsafe fn init_in(ptr: *mut Self, mapper: Mapper) {
+        unsafe {
+            let cpu = core::ptr::addr_of_mut!((*ptr).cpu);
+            core::ptr::write(cpu, CpuRp2a03::new(0));
+            let bus = core::ptr::addr_of_mut!((*ptr).bus);
+            Bus::init_in(bus, mapper);
+            reset(&mut *cpu, &mut *bus);
+        }
+    }
